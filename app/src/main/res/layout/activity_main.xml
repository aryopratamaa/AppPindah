<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="INI HALAMAN PERTAMA"
        android:textColor="@android:color/black"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.05"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="80dp" />

    <Button
        android:id="@+id/btnKedua"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pindah Kedua"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:textColor="@android:color/white"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="40dp"
        android:paddingVertical="14dp"
        android:elevation="8dp"
        android:stateListAnimator="@null"
        app:layout_constraintTop_toBottomOf="@id/textView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="36dp" />

    <LinearLayout
        android:id="@+id/socialRow1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="0dp"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@id/btnKedua"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ic_call"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="12dp"
            android:layout_margin="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@drawable/ic_call" />

        <ImageView
            android:id="@+id/ic_whatsapp"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:padding="12dp"
            android:layout_margin="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@drawable/ic_wa" />

        <ImageView
            android:id="@+id/ic_instagram"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:padding="12dp"
            android:layout_margin="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@drawable/ic_instagram" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/socialRow2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/socialRow1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ic_fb"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="12dp"
            android:layout_margin="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@drawable/ic_fb" />

        <ImageView
            android:id="@+id/ic_tiktok"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:padding="12dp"
            android:layout_margin="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@drawable/ic_tiktok" />

        <ImageView
            android:id="@+id/ic_youtube"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:padding="12dp"
            android:layout_margin="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@drawable/ic_youtube" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
